{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "headless-debug",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/cmake-build-headless-debug",
      "cacheVariables": {
        "BLOBBER_BUILD_GRAPHICS": "OFF"
      }
    },
    {
      "name": "headless-release",
      "inherits": "release",
      "binaryDir": "${sourceDir}/cmake-build-headless-release",
      "cacheVariables": {
        "BLOBBER_BUILD_GRAPHICS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 2
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 2
    },
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug",
      "jobs": 2
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      },
      "filter": {
        "exclude": {
          "label": "slow|stress|benchmark"
        }
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      },
      "filter": {
        "exclude": {
          "label": "slow|stress|benchmark"
        }
      }
    },
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      },
      "filter": {
        "exclude": {
          "label": "slow|stress|benchmark"
        }
      }
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      },
      "filter": {
        "exclude": {
          "label": "slow|stress|benchmark"
        }
      }
    }
  ]
}
