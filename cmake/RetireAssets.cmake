# Only known obsolete outputs under the configured binary directory are owned here.
if(NOT DEFINED MANAGED_BINARY_DIR OR NOT IS_DIRECTORY "${MANAGED_BINARY_DIR}")
    message(FATAL_ERROR "Retirement requires an existing managed binary directory")
endif()
file(REAL_PATH "${MANAGED_BINARY_DIR}" managed)
set(roots "${managed}/assets")
foreach(config Debug Release RelWithDebInfo MinSizeRel ${MANAGED_CONFIGS})
    if(IS_ABSOLUTE "${config}" OR config MATCHES "[/\\\\]" OR config STREQUAL "..")
        message(FATAL_ERROR "Invalid managed configuration: ${config}")
    endif()
    list(APPEND roots "${managed}/${config}/assets")
endforeach()
foreach(root IN LISTS roots)
    if(NOT IS_DIRECTORY "${root}")
        continue()
    endif()
    file(REAL_PATH "${root}" resolved)
    cmake_path(IS_PREFIX managed "${resolved}" NORMALIZE owned)
    if(NOT owned)
        message(FATAL_ERROR "Refusing retirement outside managed build: ${root}")
    endif()
    # Never follow a prepared-directory link into another asset publication.
    if(IS_SYMLINK "${root}/prepared")
        message(FATAL_ERROR "Refusing retirement through prepared symlink: ${root}")
    endif()
    file(REMOVE "${root}/preparation.json" "${root}/maze.txt" "${root}/rules/recovery.json")
    foreach(bank scene npcs loot)
        file(GLOB temporary LIST_DIRECTORIES false "${root}/prepared/${bank}.bin.tmp-*")
        file(REMOVE "${root}/prepared/${bank}.bin" ${temporary})
    endforeach()
    file(REMOVE "${root}/prepared/metadata.json" "${root}/prepared/metadata.json.tmp")
    file(REMOVE_RECURSE "${root}/prepared/derivatives")
endforeach()
