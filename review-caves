#!/usr/bin/env python3
"""Walk a standalone Damp Caves floor using the normal dungeon controls."""
import argparse
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
from tools.agent_artifacts import create, clean


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--depth', type=int, choices=(4, 5, 6), default=4)
    parser.add_argument('--seed', type=int, default=5)
    parser.add_argument('--check', action='store_true', help='Walk the routes headlessly and exit')
    parser.add_argument('--encounter', action='store_true', help='Play the encounter for this cave floor')
    parser.add_argument('--fallback', action='store_true', help='Walk the checked fallback for this depth')
    args = parser.parse_args()
    if not 0 <= args.seed <= 0xffffffff:
        parser.error('seed must fit an unsigned 32-bit integer')
    root = Path(__file__).resolve().parent
    build = root / 'cmake-build-debug'
    config = {}
    for line in (build / 'CMakeCache.txt').read_text().splitlines():
        if line.startswith(('CMAKE_COMMAND:', 'CMAKE_MAKE_PROGRAM:')):
            name, value = line.split('=', 1)
            config[name.split(':')[0]] = value
    for key in ('CMAKE_COMMAND', 'CMAKE_MAKE_PROGRAM'):
        if not Path(config.get(key, '')).is_file():
            sys.exit('Configure the Debug preset in CLion first.')
    prepared = build / 'assets/prepared'
    targets = ['blobber_review_caves']
    if not args.check:
        for target, files in (
            ('blobber_bake_world_assets', ('world/metadata.json', 'world/textures.bin')),
            ('blobber_portraits', ('portraits-small.qoi', 'portraits-large.qoi', 'portraits.tsv')),
            ('blobber_creator_art', ('creator.qoi',)),
        ):
            if target == 'blobber_bake_world_assets' or any(not (prepared / file).is_file() for file in files):
                targets.append(target)
    subprocess.run(['nice', '-n', '15', 'ionice', '-c', '3', config['CMAKE_COMMAND'],
                    '--build', str(build), '--parallel', '2', '--target', *targets], cwd=root, check=True)
    run = create(root)
    try:
        mode = 'check' if args.check else 'walk'
        command = [str(build / 'blobber_review_caves'), mode, str(args.depth), str(args.seed),
                   str(run / mode), str(root / 'assets'), str(prepared)]
        if args.encounter:
            command.append('--encounter')
        if args.fallback:
            command.append('--fallback')
        if not args.check:
            print('W/S forward/back · A/D strafe · Q/E turn · F open door · M map · Esc menu', flush=True)
        subprocess.run(command, cwd=root, check=True)
    finally:
        clean(root, run)
        clean(root, run, apply=True)


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
